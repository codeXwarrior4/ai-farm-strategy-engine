# ============================================================
# AI Farm Strategy & Decision Engine - Environment Configuration
# ============================================================
# Copy this file to .env or export variables in your shell environment.
# Never commit real credentials, tokens, or API keys to version control.

# Database Configuration (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/farm_strategy_test?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=farm_test_user
DB_PASSWORD=your_secure_database_password_here

# JWT Security
JWT_SECRET=your-minimum-32-character-secret-key-for-hmac-sha-256-validation
SERVER_PORT=8080

# Government data.gov.in AGMARKNET Mandi Price Ingestion API Key
# Sign up and obtain a free API key at: https://data.gov.in
# When left blank, the application will operate normally using local records
# and statutory MSP baselines, but live external API ingestion will be disabled.
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Open-Meteo Weather API
# Forecast and geocoding endpoints are public by default; no key required.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

