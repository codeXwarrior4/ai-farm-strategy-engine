# =============================================================
# AI Farm Strategy & Decision Engine — Root .gitignore
# =============================================================

# ---- Secrets and environment files -------------------------
.env
.env.local
.env.production
*.env
!*.env.example

# ---- Node / Frontend ----------------------------------------
node_modules/
dist/
build/
.vite/
frontend/.next/
frontend/out/

# ---- Java / Maven -------------------------------------------
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*

# ---- Python / ML Service ------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
ml-service/.venv/
ml-service/venv/
ml-service/.env
ml-service/*.egg-info/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage

# ---- Database -----------------------------------------------
*.sql.bak
dump.sql

# ---- IDE / Editor -------------------------------------------
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs_analysis.dat
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ---- Logs ---------------------------------------------------
*.log
logs/
