# ============================================================
# Backend Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in real values.
# NEVER commit .env with real secrets.
# ============================================================

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/farm_engine?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=farm_user
DB_PASSWORD=your_db_password_here

# --- JWT ---
# Use a long random string — minimum 32 characters
# Generate one with: openssl rand -base64 64
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# --- Server ---
SERVER_PORT=8080

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
